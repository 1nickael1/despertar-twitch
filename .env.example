# Copie para .env e preencha FORA DA LIVE. Nunca mostre o .env na tela.
# Recomendado: conta separada para o bot. Escopos do token: chat:read chat:edit
TWITCH_BOT_USERNAME=nome_da_conta_do_bot
TWITCH_OAUTH_TOKEN=cole_o_token_aqui
TWITCH_CHANNEL=nome_do_seu_canal

# Renovação automática do token (opcional, recomendada). Vêm do app em dev.twitch.tv/console
# (tipo Confidencial) e do "twitch token -u". O bot reescreve TWITCH_OAUTH_TOKEN e
# TWITCH_REFRESH_TOKEN sozinho quando renova.
TWITCH_CLIENT_ID=client_id_do_app
TWITCH_CLIENT_SECRET=client_secret_do_app
TWITCH_REFRESH_TOKEN=cole_o_refresh_token_aqui
